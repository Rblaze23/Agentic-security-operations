# Linux-native path; never under /mnt/d
SECOPS_DATA_DIR=/home/ramy/data/secops
# Leave empty to use sqlite under SECOPS_DATA_DIR/mlflow
SECOPS_MLFLOW_TRACKING_URI=
SECOPS_RANDOM_SEED=42
# Serving (Phase 2)
# Comma-separated API keys accepted by /predict, /predict/batch, /model, /docs. Empty = refuse all.
SECOPS_API_KEYS=
# Directory holding the exported bundles: <dir>/detector and <dir>/family (make export-models)
SECOPS_MODEL_DIR=/home/ramy/data/secops/models
SECOPS_PORT=8000

# Event store (Phase 3). Default: sqlite under SECOPS_DATA_DIR; Phase 6 points this at PostgreSQL.
SECOPS_DATABASE_URL=

# Phase 4 agent: Anthropic API key (never committed)
ANTHROPIC_API_KEY=
